<Window x:Class="Eclipse_Library.UI.FeatSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Feat"
        Height="640"
        Width="820"
        MinHeight="540"
        MinWidth="720"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,4,8,8" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="FeatSlotsText" FontSize="16" FontWeight="SemiBold" Text="Add a feat" Margin="0,0,0,8" />

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBox x:Name="SearchTextBox" Width="260" MinHeight="28" TextChanged="SearchTextBox_TextChanged" />
            <ComboBox x:Name="FilterComboBox" Width="170" Margin="8,0,0,0" SelectionChanged="FilterComboBox_SelectionChanged" />
            <TextBlock x:Name="FeatCountText" Margin="12,0,0,0" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="FeatsListBox"
                     DisplayMemberPath="DisplayName"
                     SelectionChanged="FeatsListBox_SelectionChanged" />

            <TextBox Grid.Column="1"
                     x:Name="FeatDescriptionTextBox"
                     Margin="12,0,0,0"
                     FontFamily="Consolas"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     IsReadOnly="True" />
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Add &amp; Close" Width="110" Click="AddClose_Click" />
                <Button Content="Add" Width="86" Click="Add_Click" />
                <Button Content="Close" Width="86" Click="Close_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
