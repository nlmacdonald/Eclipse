<Window x:Class="Eclipse_Library.UI.RaceSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Race"
        Height="640"
        Width="860"
        MinHeight="540"
        MinWidth="760"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,4,8,8" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Choose a Race" Margin="0,0,0,8" />

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBox x:Name="SearchTextBox" Width="280" MinHeight="28" TextChanged="SearchTextBox_TextChanged" />
            <TextBlock x:Name="RaceCountText" Margin="12,0,0,0" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="RacesListBox"
                     DisplayMemberPath="DisplayName"
                     SelectionChanged="RacesListBox_SelectionChanged" />

            <TextBox Grid.Column="1"
                     x:Name="RaceDescriptionTextBox"
                     Margin="12,0,0,0"
                     FontFamily="Consolas"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     IsReadOnly="True" />
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Choose" Width="96" Click="Choose_Click" />
                <Button Content="Close" Width="86" Click="Close_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
