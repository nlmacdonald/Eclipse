<Window x:Class="Eclipse_Library.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eclipse Library" Height="760" Width="1120" MinHeight="640" MinWidth="980">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,12,8" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,12,8" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,4,8,8" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,4" />
        </Style>
        <Style x:Key="ClassesHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5F4B2A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ClassIconButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#6E86A7" />
            <Setter Property="BorderBrush" Value="#415978" />
        </Style>
        <Style x:Key="AbilityAdjustButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="17" />
            <Setter Property="MinHeight" Value="17" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Bottom" BorderBrush="#D0D7DE" BorderThickness="1,1,0,0" Padding="10,6">
            <TextBlock x:Name="StatusText" Text="Ready" />
        </Border>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="FileNew_Click" />
                <MenuItem Header="_Open" Click="FileOpen_Click" />
                <Separator />
                <MenuItem Header="_Save" Click="FileSave_Click" />
                <MenuItem Header="Save _As" Click="FileSaveAs_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="FileExit_Click" />
            </MenuItem>
            <MenuItem Header="_Edit" />
            <MenuItem Header="_Character">
                <MenuItem Header="_Configure" Click="ConfigureHero_Click" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Template Editor" Click="OpenTemplateEditor_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="HelpAbout_Click" />
            </MenuItem>
        </Menu>

        <Grid x:Name="TemplateBuildDialogContent" Visibility="Collapsed">
            <TabControl Margin="8">
                    <TabItem Header="Template">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Template Identity" Margin="0,0,0,12" />

                                <TextBlock Text="Template Name" />
                                <TextBox x:Name="TemplateNameTextBox" TextChanged="TemplateMetadata_Changed" />

                                <TextBlock Text="Template Id" />
                                <TextBox x:Name="TemplateIdTextBox" IsReadOnly="True" />

                                <TextBlock Text="Rule Set" />
                                <ComboBox x:Name="RulesetComboBox" SelectionChanged="RulesetComboBox_SelectionChanged" />

                                <TextBlock Text="Template Tag" />
                                <ComboBox x:Name="TemplateTagComboBox" />

                                <TextBlock Text="Max Class Levels" />
                                <TextBox x:Name="MaxClassLevelsTextBox" Text="" />

                                <TextBlock Text="Alignment" />
                                <TextBox x:Name="AlignmentTextBox" Text="Any" />

                                <TextBlock Text="Starting Gold" />
                                <TextBox x:Name="TemplateStartingGoldTextBox" Text="" />

                                <TextBlock Text="Notes (e.g. class skills)" />
                                <TextBox x:Name="TemplateNotesTextBox" AcceptsReturn="True" TextWrapping="Wrap" Height="80" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="New Template" Click="NewTemplate_Click" />
                                    <Button Content="Apply Template Metadata" Click="ApplyTemplateMetadata_Click" />
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0"
                                         x:Name="TemplateSummaryTextBox"
                                         FontFamily="Consolas"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         IsReadOnly="True" />

                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="340" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Template Library" Margin="0,0,0,8" />
                                        <ListBox x:Name="AvailableTemplatesListBox" MinHeight="140" DisplayMemberPath="DisplayName" />
                                        <WrapPanel>
                                            <Button Content="Reload Library" Click="ReloadTemplateLibrary_Click" />
                                            <Button Content="Load Template" Click="LoadSelectedTemplate_Click" />
                                            <Button Content="Save As Custom" Click="SaveTemplateAsCustom_Click" />
                                        </WrapPanel>

                                        <TextBlock Text="Load Segment (class levels)" Margin="0,12,0,0" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="SegmentFromTextBox" Width="60" Text="1" />
                                            <TextBlock Text="to" VerticalAlignment="Center" Margin="4,0" />
                                            <TextBox x:Name="SegmentToTextBox" Width="60" Text="20" />
                                            <TextBlock Text="start at" VerticalAlignment="Center" Margin="8,0,4,0" />
                                            <TextBox x:Name="SegmentStartAtTextBox" Width="60" Text="1" />
                                        </StackPanel>
                                        <WrapPanel>
                                            <Button Content="Load Segment Rows" Click="LoadSegmentRows_Click" />
                                            <Button Content="Apply Segment" Click="ApplySegmentRows_Click" />
                                            <Button Content="Clear Segment" Click="ClearSegmentRows_Click" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <DataGrid Grid.Column="1"
                                              x:Name="SegmentRowsGrid"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="False"
                                              Margin="12,0,0,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Class Lvl" Binding="{Binding ClassLevel}" IsReadOnly="True" Width="70" />
                                            <DataGridTextColumn Header="Target Lvl" Binding="{Binding TargetLevel, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                            <DataGridTextColumn Header="Summary" Binding="{Binding DisplayName}" IsReadOnly="True" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Expenditures">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Level Purchases" Margin="0,0,0,12" />

                                    <TextBlock Text="Editing Level" />
                                    <TextBox x:Name="EditingLevelTextBox" Text="1" IsReadOnly="True" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="New Level" Click="NewLevel_Click" />
                                        <Button Content="Save Level" Click="SaveLevel_Click" />
                                    </StackPanel>
                                    <TextBlock Text="Template Levels" Margin="0,8,0,0" />
                                    <ListBox x:Name="TemplateLevelsListBox"
                                             MinHeight="96"
                                             DisplayMemberPath="DisplayName"
                                             SelectionChanged="TemplateLevelsListBox_SelectionChanged"
                                             Margin="0,4,12,12" />

                                    <TextBlock Text="Hit Die" />
                                    <ComboBox x:Name="HitDieComboBox" />
                                    <Button Content="Add Hit Die" Click="AddHitDie_Click" />

                                    <TextBlock Text="Warcraft Levels" Margin="0,12,0,0" />
                                    <TextBox x:Name="WarcraftTextBox" Text="1" />
                                    <Button Content="Add Warcraft" Click="AddWarcraft_Click" />

                                    <TextBlock Text="Save Type" Margin="0,12,0,0" />
                                    <ComboBox x:Name="SaveTypeComboBox" />
                                    <TextBlock Text="Save Bonus" />
                                    <TextBox x:Name="SaveBonusTextBox" Text="1" />
                                    <Button Content="Add Save Bonus" Click="AddSave_Click" />

                                    <TextBlock Text="Skill Name" Margin="0,12,0,0" />
                                    <TextBox x:Name="SkillNameTextBox" Text="Heal" />
                                    <TextBlock Text="Skill Ranks" />
                                    <TextBox x:Name="SkillRanksTextBox" Text="1" />
                                    <CheckBox x:Name="RelevantSkillCheckBox" Content="Relevant skill" IsChecked="True" Margin="0,4,12,8" />
                                    <Button Content="Add Skill Ranks" Click="AddSkillRanks_Click" />

                                    <TextBlock Text="Class Skills" Margin="0,12,0,0" />
                                    <ListBox x:Name="ClassSkillsListBox"
                                             MinHeight="120"
                                             SelectionMode="Multiple"
                                             DisplayMemberPath="Name"
                                             Margin="0,4,12,8" />
                                    <Button Content="Save Class Skills" Click="SaveClassSkills_Click" />

                                    <TextBlock Text="Base Caster Level" Margin="0,12,0,0" />
                                    <TextBox x:Name="BaseCasterLevelTextBox" Text="1" />
                                    <Button Content="Add Base Caster Level" Click="AddBaseCasterLevel_Click" />

                                    <TextBlock Text="Magic Progression" Margin="0,12,0,0" />
                                    <ComboBox x:Name="MagicProgressionComboBox" />
                                    <TextBlock Text="Magic Levels" />
                                    <TextBox x:Name="MagicLevelsTextBox" Text="1" />
                                    <Button Content="Add Magic Levels" Click="AddMagicLevels_Click" />

                                    <TextBlock Text="Bonus Feats" Margin="0,12,0,0" />
                                    <TextBox x:Name="BonusFeatsTextBox" Text="1" />
                                    <Button Content="Add Bonus Feat" Click="AddBonusFeats_Click" />
                                </StackPanel>
                            </ScrollViewer>

                            <Grid Grid.Column="1" Margin="16,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="170" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Special Abilities" Margin="0,0,0,12" />
                                <TextBox Grid.Row="0" x:Name="AbilitySearchTextBox" Margin="0,32,0,8" TextChanged="AbilitySearch_TextChanged" />
                                <ListBox Grid.Row="1" x:Name="AbilitiesListBox" DisplayMemberPath="DisplayName" SelectionChanged="AbilitiesListBox_SelectionChanged" />
                                <TextBlock Grid.Row="2" Text="Options" FontWeight="SemiBold" Margin="0,12,0,4" />
                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="AbilityOptionsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding DisplayName}" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Button Grid.Row="4" Content="Add Ability" Click="AddAbility_Click" />
                            </Grid>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Template Purchases" Margin="0,0,0,12" />
                                <DataGrid Grid.Row="1" x:Name="TemplatePurchasesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="70" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="120" />
                                        <DataGridTextColumn Header="CP" Binding="{Binding CostCp}" Width="60" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Grid.Row="2">
                                    <TextBlock x:Name="TemplateCpSummaryText" Margin="0,0,0,6" />
                                    <Button Content="Remove Selected" Click="RemoveSelectedPurchase_Click" />
                                    <Button Content="Clear Level" Click="ClearTemplate_Click" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
            </TabControl>
        </Grid>

        <TabControl x:Name="MainTabs" Margin="12">
            <TabItem Header="Character Build">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.12*" />
                        <ColumnDefinition Width="0.88*" />
                    </Grid.ColumnDefinitions>

                    <TabControl x:Name="CharacterBuildTabs">
                        <TabItem Header="Classes">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" BorderBrush="#C9B78F" BorderThickness="1" Background="#FBF1DC">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="#B86A1C" Padding="10,4">
                                            <TextBlock Foreground="White" FontWeight="SemiBold" Text="Classes and Templates" TextAlignment="Center" />
                                        </Border>

                                        <Grid Grid.Row="1" Margin="10,8,10,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="72" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource ClassesHeaderText}" Text="Lvl" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource ClassesHeaderText}" Text="Class" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource ClassesHeaderText}" Text="HP" />
                                            <TextBlock Grid.Column="3" Style="{StaticResource ClassesHeaderText}" Text="Favored Bonus" />
                                        </Grid>

                                        <ListBox Grid.Row="2"
                                                 x:Name="ClassLevelsListBox"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="8,3" Padding="8,6" BorderBrush="#D4C29C" BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="44" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="72" />
                                                                <ColumnDefinition Width="160" />
                                                                <ColumnDefinition Width="72" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding CharacterLevel}" HorizontalAlignment="Center" FontSize="16" />

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <TextBlock Text="*" Foreground="#9E9E9E" FontSize="18" Margin="0,0,6,0" />
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding TemplateName}" FontSize="17" FontWeight="SemiBold" Foreground="#1A1A1A" />
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding HitDieLabel}" Foreground="#5F4B2A" />
                                                                        <TextBlock Text="  template level " Foreground="#7B6A50" />
                                                                        <TextBlock Text="{Binding TemplateLevel}" Foreground="#7B6A50" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <TextBox Grid.Column="2"
                                                                     Text="{Binding HpNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Width="48"
                                                                     Margin="0"
                                                                     HorizontalContentAlignment="Center"
                                                                     ToolTip="{Binding HpToolTip}">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                        <Setter Property="IsReadOnly" Value="False" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsFirstLevel}" Value="True">
                                                                                <Setter Property="IsReadOnly" Value="True" />
                                                                                <Setter Property="Background" Value="#E7DDC8" />
                                                                                <Setter Property="Foreground" Value="#4F432F" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>

                                                            <ComboBox Grid.Column="3"
                                                                      ItemsSource="{Binding FavoredBonusOptions}"
                                                                      SelectedItem="{Binding FavoredBonus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      IsEditable="True"
                                                                      IsEnabled="{Binding IsFavoredBonusEnabled}"
                                                                      Margin="0"
                                                                      MinHeight="24">
                                                            </ComboBox>

                                                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <Button Style="{StaticResource ClassIconButton}"
                                                                        Content="?"
                                                                        ToolTip="{Binding ClassDescription}" />
                                                                <Button Style="{StaticResource ClassIconButton}"
                                                                        Content="x"
                                                                        Tag="{Binding}"
                                                                        ToolTip="Remove this level"
                                                                        Click="RemoveClassLevel_Click" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Button Grid.Row="3"
                                                Content="Level Up"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Margin="8,8,8,8"
                                                Click="AddClassLevel_Click" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock x:Name="ClassesSummaryText" Text="No class levels added." />
                                    <Button Content="Remove Selected Level" HorizontalAlignment="Left" Click="RemoveSelectedClassLevel_Click" />
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Background">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="0.95*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Race:" FontWeight="SemiBold" Margin="0,0,8,8" />
                                    <Button Grid.Column="1"
                                            x:Name="RaceButton"
                                            Content="Choose Race"
                                            HorizontalContentAlignment="Left"
                                            Click="OpenRaceSelection_Click" />

                                    <TextBlock Grid.Column="3" Text="Size:" FontWeight="SemiBold" Margin="16,0,8,8" />
                                    <ComboBox Grid.Column="4"
                                              x:Name="SizeComboBox"
                                              SelectionChanged="Size_SelectionChanged" />

                                    <TextBlock Grid.Row="1" Text="Alignment:" FontWeight="SemiBold" Margin="0,0,8,8" />
                                    <ComboBox Grid.Row="1"
                                              Grid.Column="1"
                                              x:Name="CharacterAlignmentComboBox"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              ToolTip="{Binding SelectedItem.Description, RelativeSource={RelativeSource Self}}"
                                              SelectionChanged="Alignment_SelectionChanged" />

                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Deity:" FontWeight="SemiBold" Margin="16,0,8,8" />
                                    <TextBox Grid.Row="1" Grid.Column="4" x:Name="DeityTextBox" Text="Choose Deity" TextChanged="BackgroundInput_TextChanged" />
                                </Grid>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                    <Border Background="#B86A1C" Padding="8,4">
                                        <TextBlock Foreground="White" FontWeight="SemiBold" Text="Factions" TextAlignment="Center" />
                                    </Border>
                                    <Button Content="Add Factions" HorizontalContentAlignment="Center" />

                                    <Border Background="#B86A1C" Padding="8,4" Margin="0,12,0,0">
                                        <TextBlock Foreground="White" FontWeight="SemiBold" Text="Add Alternate Racial Traits" TextAlignment="Center" />
                                    </Border>
                                    <Button Content="Select a Race First" IsEnabled="False" HorizontalContentAlignment="Center" />

                                    <Border Background="#B86A1C" Padding="8,4" Margin="0,12,0,0">
                                        <TextBlock Foreground="White" FontWeight="SemiBold" Text="Racial, Template &amp; Faction Abilities" TextAlignment="Center" />
                                    </Border>
                                    <ItemsControl x:Name="RacialAbilitiesItemsControl" MinHeight="120">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,1" Background="#F4E7CA">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="32" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               Padding="8,5"
                                                               ToolTip="{Binding Description}" />
                                                    <Border Grid.Column="1"
                                                            Width="22"
                                                            Height="22"
                                                            Margin="4,2"
                                                            BorderBrush="#8F8F8F"
                                                            BorderThickness="1"
                                                            Background="#E8E8E8"
                                                            ToolTip="{Binding Description}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#E8E8E8" />
                                                                <Setter Property="BorderBrush" Value="#8F8F8F" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#F7F7F7" />
                                                                        <Setter Property="BorderBrush" Value="#4E78A8" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="?"
                                                                   Foreground="#333333"
                                                                   FontWeight="Bold"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <Border Background="#B86A1C" Padding="8,4">
                                        <TextBlock Foreground="White" FontWeight="SemiBold" Text="Starting Languages" TextAlignment="Center" />
                                    </Border>
                                    <ListBox x:Name="KnownLanguagesListBox" MinHeight="88" BorderBrush="#D4C29C" />
                                    <Button Content="All starting languages learned."
                                            HorizontalContentAlignment="Center"
                                            Click="ChooseStartingLanguages_Click" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <CheckBox x:Name="ReplaceCommonCheckBox" Content="Replace Common" Checked="BackgroundInput_Checked" Unchecked="BackgroundInput_Checked" />
                                        <Button Content="Remove Selected" Margin="12,0,0,0" Click="RemoveSelectedLanguage_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Abilities">
                            <ScrollViewer Margin="12" VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.05*" />
                                        <ColumnDefinition Width="0.95*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <Border Background="#B86A1C" Padding="8,4">
                                            <TextBlock Foreground="White" FontWeight="SemiBold" Text="Ability Scores" TextAlignment="Center" />
                                        </Border>

                                        <Grid Margin="8,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="82" />
                                                <ColumnDefinition Width="74" />
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="50" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="46" />
                                                <RowDefinition Height="46" />
                                                <RowDefinition Height="46" />
                                                <RowDefinition Height="46" />
                                                <RowDefinition Height="46" />
                                                <RowDefinition Height="46" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" x:Name="StrengthAbilityLabel" VerticalAlignment="Center"><TextBlock Text="STR" FontSize="26" FontWeight="Bold" LineHeight="25" /><TextBlock Text="Strength" FontSize="11" Foreground="#666" /></StackPanel>
                                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="StrengthTextBox" Text="10" Width="58" FontSize="24" HorizontalContentAlignment="Center" TextChanged="AbilityScore_TextChanged" />
                                            <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"><Button Style="{StaticResource AbilityAdjustButton}" Content="▲" Tag="Strength:1" Click="AbilityScoreAdjust_Click" /><Button Style="{StaticResource AbilityAdjustButton}" Content="▼" Tag="Strength:-1" Click="AbilityScoreAdjust_Click" /></StackPanel>
                                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="StrengthModText" Text="+0" FontSize="16" Foreground="#697A8A" />

                                            <StackPanel Grid.Row="1" x:Name="DexterityAbilityLabel" VerticalAlignment="Center"><TextBlock Text="DEX" FontSize="26" FontWeight="Bold" LineHeight="25" /><TextBlock Text="Dexterity" FontSize="11" Foreground="#666" /></StackPanel>
                                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="DexterityTextBox" Text="10" Width="58" FontSize="24" HorizontalContentAlignment="Center" TextChanged="AbilityScore_TextChanged" />
                                            <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"><Button Style="{StaticResource AbilityAdjustButton}" Content="▲" Tag="Dexterity:1" Click="AbilityScoreAdjust_Click" /><Button Style="{StaticResource AbilityAdjustButton}" Content="▼" Tag="Dexterity:-1" Click="AbilityScoreAdjust_Click" /></StackPanel>
                                            <TextBlock Grid.Row="1" Grid.Column="3" x:Name="DexterityModText" Text="+0" FontSize="16" Foreground="#697A8A" />

                                            <StackPanel Grid.Row="2" x:Name="ConstitutionAbilityLabel" VerticalAlignment="Center"><TextBlock Text="CON" FontSize="26" FontWeight="Bold" LineHeight="25" /><TextBlock Text="Constitution" FontSize="11" Foreground="#666" /></StackPanel>
                                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ConstitutionTextBox" Text="10" Width="58" FontSize="24" HorizontalContentAlignment="Center" TextChanged="AbilityScore_TextChanged" />
                                            <StackPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"><Button Style="{StaticResource AbilityAdjustButton}" Content="▲" Tag="Constitution:1" Click="AbilityScoreAdjust_Click" /><Button Style="{StaticResource AbilityAdjustButton}" Content="▼" Tag="Constitution:-1" Click="AbilityScoreAdjust_Click" /></StackPanel>
                                            <TextBlock Grid.Row="2" Grid.Column="3" x:Name="ConstitutionModText" Text="+0" FontSize="16" Foreground="#697A8A" />

                                            <StackPanel Grid.Row="3" x:Name="IntelligenceAbilityLabel" VerticalAlignment="Center"><TextBlock Text="INT" FontSize="26" FontWeight="Bold" LineHeight="25" /><TextBlock Text="Intelligence" FontSize="11" Foreground="#666" /></StackPanel>
                                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="IntelligenceTextBox" Text="10" Width="58" FontSize="24" HorizontalContentAlignment="Center" TextChanged="AbilityScore_TextChanged" />
                                            <StackPanel Grid.Row="3" Grid.Column="2" VerticalAlignment="Center"><Button Style="{StaticResource AbilityAdjustButton}" Content="▲" Tag="Intelligence:1" Click="AbilityScoreAdjust_Click" /><Button Style="{StaticResource AbilityAdjustButton}" Content="▼" Tag="Intelligence:-1" Click="AbilityScoreAdjust_Click" /></StackPanel>
                                            <TextBlock Grid.Row="3" Grid.Column="3" x:Name="IntelligenceModText" Text="+0" FontSize="16" Foreground="#697A8A" />

                                            <StackPanel Grid.Row="4" x:Name="WisdomAbilityLabel" VerticalAlignment="Center"><TextBlock Text="WIS" FontSize="26" FontWeight="Bold" LineHeight="25" /><TextBlock Text="Wisdom" FontSize="11" Foreground="#666" /></StackPanel>
                                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="WisdomTextBox" Text="10" Width="58" FontSize="24" HorizontalContentAlignment="Center" TextChanged="AbilityScore_TextChanged" />
                                            <StackPanel Grid.Row="4" Grid.Column="2" VerticalAlignment="Center"><Button Style="{StaticResource AbilityAdjustButton}" Content="▲" Tag="Wisdom:1" Click="AbilityScoreAdjust_Click" /><Button Style="{StaticResource AbilityAdjustButton}" Content="▼" Tag="Wisdom:-1" Click="AbilityScoreAdjust_Click" /></StackPanel>
                                            <TextBlock Grid.Row="4" Grid.Column="3" x:Name="WisdomModText" Text="+0" FontSize="16" Foreground="#697A8A" />

                                            <StackPanel Grid.Row="5" x:Name="CharismaAbilityLabel" VerticalAlignment="Center"><TextBlock Text="CHA" FontSize="26" FontWeight="Bold" LineHeight="25" /><TextBlock Text="Charisma" FontSize="11" Foreground="#666" /></StackPanel>
                                            <TextBox Grid.Row="5" Grid.Column="1" x:Name="CharismaTextBox" Text="10" Width="58" FontSize="24" HorizontalContentAlignment="Center" TextChanged="AbilityScore_TextChanged" />
                                            <StackPanel Grid.Row="5" Grid.Column="2" VerticalAlignment="Center"><Button Style="{StaticResource AbilityAdjustButton}" Content="▲" Tag="Charisma:1" Click="AbilityScoreAdjust_Click" /><Button Style="{StaticResource AbilityAdjustButton}" Content="▼" Tag="Charisma:-1" Click="AbilityScoreAdjust_Click" /></StackPanel>
                                            <TextBlock Grid.Row="5" Grid.Column="3" x:Name="CharismaModText" Text="+0" FontSize="16" Foreground="#697A8A" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="8,8,0,0">
                                            <TextBlock Text="Level Adjustment:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox x:Name="AbilityScoreAdjustmentComboBox" Width="132" />
                                            <Button Content="Add" Margin="8,0,0,0" Click="AddAbilityScoreAdjustment_Click" />
                                            <Button Content="Remove" Margin="8,0,0,0" Click="RemoveAbilityScoreAdjustment_Click" />
                                        </StackPanel>
                                        <TextBlock x:Name="AbilityScoreAdjustmentsSummaryText" Margin="8,4,0,0" Foreground="#697A8A" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <Border Background="#B86A1C" Padding="8,4">
                                            <TextBlock Foreground="White" FontWeight="SemiBold" Text="Attack Bonus" TextAlignment="Center" />
                                        </Border>
                                        <UniformGrid Columns="2" Margin="0,8,0,12">
                                            <TextBlock Text="Attack Bonus:" FontWeight="SemiBold" />
                                            <TextBlock x:Name="BabText" Text="+0" FontWeight="SemiBold" />
                                            <TextBlock Text="Attack (Melee):" FontWeight="SemiBold" />
                                            <TextBlock x:Name="MeleeBabText" Text="+0" FontWeight="SemiBold" />
                                            <TextBlock Text="Attack (Range):" FontWeight="SemiBold" />
                                            <TextBlock x:Name="RangedBabText" Text="+0" FontWeight="SemiBold" />
                                        </UniformGrid>

                                        <Border Background="#B86A1C" Padding="8,4">
                                            <TextBlock Foreground="White" FontWeight="SemiBold" Text="Defenses" TextAlignment="Center" />
                                        </Border>
                                        <UniformGrid Columns="2" Margin="0,8,0,12">
                                            <TextBlock Text="Armor Class:" FontWeight="SemiBold" />
                                            <TextBlock x:Name="ArmorClassText" Text="10" FontWeight="SemiBold" />
                                            <TextBlock Text="Grapple:" FontWeight="SemiBold" />
                                            <TextBlock x:Name="GrappleText" Text="+0" FontWeight="SemiBold" />
                                            <TextBlock Text="Space / Reach:" FontWeight="SemiBold" />
                                            <TextBlock x:Name="SpaceReachText" Text="5 ft. / 5 ft." FontWeight="SemiBold" />
                                            <TextBlock Text="Fortitude Save:" FontWeight="SemiBold" />
                                            <TextBlock x:Name="FortSaveText" Text="+0" FontWeight="SemiBold" />
                                            <TextBlock Text="Reflex Save:" FontWeight="SemiBold" />
                                            <TextBlock x:Name="RefSaveText" Text="+0" FontWeight="SemiBold" />
                                            <TextBlock Text="Will Save:" FontWeight="SemiBold" />
                                            <TextBlock x:Name="WillSaveText" Text="+0" FontWeight="SemiBold" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Character">
                            <ScrollViewer Margin="12" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Character" Margin="0,0,0,12" />

                                    <TextBlock Text="Name" />
                                    <TextBox x:Name="CharacterNameTextBox" Text="New Character" TextChanged="CharacterInput_TextChanged" />

                                    <TextBlock Text="Player Name" />
                                    <TextBox x:Name="PlayerNameTextBox" Text="" TextChanged="CharacterInput_TextChanged" />

                                    <TextBlock Text="Target Level" />
                                    <TextBox x:Name="TargetLevelTextBox" Text="1" TextChanged="CharacterInput_TextChanged" />

                                    <TextBlock Text="Hit Points" />
                                    <TextBox x:Name="HitPointsTextBox" Text="0" TextChanged="CharacterInput_TextChanged" />

                                    <TextBlock Text="Starting Gold" />
                                    <TextBox x:Name="StartingGoldTextBox" Text="0" TextChanged="CharacterInput_TextChanged" />

                                    <TextBlock Text="Experience" Margin="0,12,0,0" />
                                    <TextBox x:Name="ExperienceTextBox" Text="0" TextChanged="Experience_TextChanged" />

                                    <TextBlock Text="PF XP Progression" />
                                    <ComboBox x:Name="PathfinderProgressionComboBox" SelectionChanged="PathfinderProgression_SelectionChanged" />

                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="Configure Hero" Click="ConfigureHero_Click" />
                                        <Button Content="New Hero" Click="NewHero_Click" />
                                        <Button Content="Recalculate" Click="ApplyTemplate_Click" />
                                        <Button Content="Reset" Click="Reset_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                    <TabItem Header="Skills">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="SkillPointsSummaryText" Text="Skill points" Margin="0,0,0,8" />

                            <DataGrid Grid.Row="1"
                                      x:Name="SkillsGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Skill" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="*"
                                                               Width="16"
                                                               Foreground="#C62828"
                                                               FontSize="14"
                                                               VerticalAlignment="Center"
                                                               ToolTip="Class skill">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsClassSkill}" Value="False">
                                                                        <Setter Property="Visibility" Value="Hidden" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#111111" />
                                                                <Setter Property="FontWeight" Value="Normal" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsClassSkill}" Value="True">
                                                                        <Setter Property="Foreground" Value="#005A9C" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Attr" Binding="{Binding AttributeShort}" Width="60" />
                                    <DataGridTextColumn Header="Attr Mod" Binding="{Binding AttributeModifierText}" Width="80" />
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeModifierText}" Width="60" />
                                    <DataGridTextColumn Header="SP" Binding="{Binding SkillPointsSpent}" Width="50" />
                                    <DataGridTextColumn Header="Ranks" Binding="{Binding RanksText}" Width="70" />
                                    <DataGridTemplateColumn Header="Total Mod" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TotalModifierText}"
                                                           ToolTip="{Binding TotalModifierBreakdown}"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="&lt;"
                                                            Width="28"
                                                            Height="28"
                                                            MinWidth="28"
                                                            Padding="0"
                                                            Margin="0,0,6,0"
                                                            Click="Skill_Decrement_Click"
                                                            Tag="{Binding}"
                                                            IsEnabled="{Binding CanDecrease}"
                                                            ToolTip="Spend one fewer skill point" />
                                                    <Button Content="&gt;"
                                                            Width="28"
                                                            Height="28"
                                                            MinWidth="28"
                                                            Padding="0"
                                                            Click="Skill_Increment_Click"
                                                            Tag="{Binding}"
                                                            ToolTip="Spend one more skill point" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="Add Additional Skill" Width="180" Click="AddSpecializedSkill_Click" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Feats">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Margin="0,0,0,8">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Feats" />
                                <Button DockPanel.Dock="Right" Content="Add Feat" Click="OpenFeatSelection_Click" />
                            </DockPanel>

                            <TextBlock Grid.Row="1" x:Name="FeatsSummaryText" Text="Feats" Margin="0,0,0,8" />

                            <DataGrid Grid.Row="2"
                                      x:Name="SelectedFeatsGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Feat" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Remove Selected" Click="RemoveSelectedFeat_Click" />
                                <Button Content="Remove One" Click="RemoveOneSelectedFeat_Click" />
                                <Button Content="Clear Feats" Click="ClearFeats_Click" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    </TabControl>

                    <Grid Grid.Column="1" Margin="12,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="140" />
                        </Grid.RowDefinitions>

                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Statblock" Margin="0,0,0,8" />
                        <TextBox Grid.Row="1"
                                 x:Name="StatBlockTextBox"
                                 FontFamily="Consolas"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 IsReadOnly="True" />

                        <DockPanel Grid.Row="2" Margin="0,12,0,8">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Diagnostics" />
                            <TextBlock DockPanel.Dock="Right"
                                       x:Name="DiagnosticsSummaryText"
                                       Foreground="#697A8A"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                        <DataGrid Grid.Row="3"
                                  x:Name="DiagnosticsGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="76" />
                                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="54" />
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="150" />
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="150" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
